# Create private settings with: .\start-web.ps1 -Init
# Java .properties syntax: KEY=value, no quotes or $env: prefix.
# Obtain credentials and the CA certificate from the database owner.
AIVEN_HOST=pg-your-service.aivencloud.com
AIVEN_PORT=replace_with_service_port
AIVEN_DATABASE=defaultdb
AIVEN_USER=avnadmin
AIVEN_PASSWORD=replace_with_private_password
AIVEN_CA_CERT=./ca.pem
JWT_SECRET=replace_with_base64_key
# Optional integrations. Empty values do not prove live delivery/upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_PROVIDER=brevo
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Hoa Tuoi Sai Gon
BREVO_API_KEY=
MOMO_MODE=mock
