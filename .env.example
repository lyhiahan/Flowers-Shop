# ===================================================================
# MÔI TRƯỜNG VẬN HÀNH / BIẾN MÔI TRƯỜNG DỰ ÁN SHOP HOA TƯƠI
# Sao chép file này thành .env hoặc cấu hình trực tiếp trên server/Docker
# ===================================================================

# 1. Cơ sở dữ liệu (SQL Server)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=RentalShop
DB_USERNAME=rental_user
DB_PASSWORD=RentalShop123!
# Hoặc truyền URL hoàn chỉnh:
# DB_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=RentalShop;encrypt=false;trustServerCertificate=true;sendStringParametersAsUnicode=true;TransparentNetworkIPResolution=false;loginTimeout=30;

# 2. Cấu hình gửi Mail (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-google-app-password

# 3. Cổng thanh toán MoMo Sandbox / Production
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1wa8ngf4S01Jn72fhip7aqj7
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:8080/payment/momo-return
MOMO_NOTIFY_URL=http://localhost:8080/payment/momo-ipn

# 4. Cloudinary (Lưu trữ ảnh tải lên)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. Bảo mật JWT (Tối thiểu 64 ký tự khi chạy Production)
JWT_SECRET=production-super-secret-key-at-least-64-characters-long-for-hs256-security-00000000
