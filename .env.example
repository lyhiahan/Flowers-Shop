# scripts/sqlserver.ps1 reads ONLY the three CLOUDINARY_* entries from .env.
# Explicit terminal variables override .env; settings are restored after exit.
# Other entries below are a reference for terminal/IDE configuration only.
# Spring Boot and scripts/maven.ps1 do not automatically read .env.
# scripts/run-local.ps1 loads .env without printing secrets; explicit process variables win.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=RentalShop;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true;
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=replace_locally
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=replace_locally
# OTP delivery via email API: sender is configured once; recipients are dynamic.
MAIL_PROVIDER=brevo
MAIL_FROM_EMAIL=your_verified_sender@example.com
MAIL_FROM_NAME=Hoa Tuoi Sai Gon
BREVO_API_KEY=replace_locally
# Optional legacy SMTP only when MAIL_PROVIDER=smtp:
# SPRING_MAIL_USERNAME=your_smtp_user
# SPRING_MAIL_PASSWORD=your_smtp_credential
# Generate a random Base64 value from at least 32 random bytes.
JWT_SECRET=
APP_DEMO_DATA_ENABLED=false
